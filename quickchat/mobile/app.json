{
  "expo": {
    "name": "NotApp",
    "slug": "quickchat",
    "scheme": "quickchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/quickchat-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quickchat.app"
    },
    "android": {
      "package": "com.quickchat.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/quickchat-adaptive-icon.png",
        "backgroundColor": "#1659CD"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "144b4c35-0a02-4d59-b935-242e30f4f310"
      }
    }
  }
}